{
    "name": "phpbbmodders/adduser",
    "type": "phpbb-extension",
    "description": "Allows administrators to add users to their board.",
    "homepage": "https://www.phpbbmodders.com/",
    "version": "1.0.5",
    "time": "2026-09-28",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "phpBB Modders",
            "email": "board@phpbbmodders.com",
            "homepage": "https://www.phpbbmodders.com/",
            "role": "Extension Developer"
        },
		{
			"name": "Rich McGirr",
			"role": "Former Extension Developer"
		},
		{
			"name": "tumba25",
			"role": "Former Extension Developer"
		}
    ],
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0"
    },
    "extra": {
        "display-name": "Add User",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.19,<4.0.0@dev"
		},
		"version-check": {
			"host": "www.phpbb.com",
			"directory": "/customise/db/extension/acp_add_user_2",
